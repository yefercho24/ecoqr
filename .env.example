# Copia este archivo como .env y ajusta los valores (o defínelos en tu plataforma de despliegue).

# --- Administrador principal (se crea la PRIMERA vez que arranca el servidor) ---
ADMIN_USER=jaime
ADMIN_NOMBRE=Profesor Jaime
# Si la dejas vacía se genera una y aparece en la consola. Después se cambia desde el panel.
ADMIN_PASSWORD=

# --- Dirección pública de la app (la usa el código QR). Ejemplo: https://ecoqr.micolegio.edu.co ---
PUBLIC_URL=

# --- Hora: desfase de Colombia respecto a UTC (no cambies esto si el colegio está en Colombia) ---
TZ_OFFSET_HORAS=-5

# --- Dónde se guardan la base de datos y las fotos (debe ser un disco que NO se borre al reiniciar) ---
DATA_DIR=./data

# --- IA ---
# Clave de la API de Claude (consola de Anthropic). SECRETA: solo aquí o en las variables de tu plataforma.
# Si la defines, la app usa Claude para identificar los residuos (no hace falta entrenar un modelo).
ANTHROPIC_API_KEY=
# Modelo (el más barato por defecto)
CLAUDE_MODELO=claude-haiku-5-5
# Tope de fotos por día enviadas a la IA de pago (protege tu crédito). 0 = sin tope
LIMITE_DIARIO_IA=1500
# 1 = resultados INVENTADOS para probar. Nunca en producción: sin modelo, la app avisa que no está lista.
MODO_DEMO=
# Si la IA está menos segura que esto, pide otra foto en vez de adivinar
UMBRAL_CONFIANZA=0.6

# --- Límites y privacidad ---
LIMITE_SESION=8        # fotos por minuto por estudiante
LIMITE_IP=200          # fotos por minuto por red (todo el colegio comparte WiFi)
INTENTOS_LOGIN=5       # contraseñas erradas permitidas cada 10 minutos
RETENCION_DIAS=0       # borrar reportes y fotos con más de N días (0 = nunca)
